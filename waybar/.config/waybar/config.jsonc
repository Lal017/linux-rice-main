// -*- mode: jsonc -*-
{
    //"layer": "top", // Waybar at top layer
    // "output": "", //outputs to all monitors by default
    "position": "top", // Waybar position (top|bottom|left|right)
    //"height": 46, // Waybar height (to be removed for auto height)
    // "width": 1280, // Waybar width
    "spacing": 4, // Gaps between modules (4px)
    "margin-top": 10,
    "margin-left": 0,
    "margin-right": 0,
    // Choose the order of the modules
    "modules-left": [
        "hyprland/workspaces",
        "group/music"
    ],
    "modules-center": [
        "wlr/taskbar"
    ],
    "modules-right": [
        "clock",
        "group/toolbar"
    ],

    "group/toolbar": {
        "orientation": "horizontal",
        "modules": [
            "group/volume",
            "battery",
            "network",
            "custom/power"
        ]
    },
    "group/music": {
        "orientation": "horizontal",
        "modules": [
            "custom/cava",
            "mpris"
        ]
    },
    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "active": "⦿",
            "default": "○"
        },
        "sort-by-number": true,
        "all-outputs": true
    },
    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "wlogout --buttons-per-row 4"
    },
    "clock": {
        "format": "{:%I:%M %p}",
        "format-alt": "{:%Y-%m-%d}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#ffead3'><b>{}</b></span>",
                "days": "<span color='#ecc6d9'><b>{}</b></span>",
                "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
                "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
            }
        }
    },
    "bluetooth": {
        "format": "",
        "format-connected": " {device_alias}",
        "format-connected-battery": " {device_alias} {device_battery_percentage}%",
        // "format-device-preference": [ "device1", "device2" ], // preference list deciding the displayed device
        "tooltip-format": "{controller_alias}\n\n{num_connections} connected",
        "tooltip-format-connected": "{controller_alias}\n\n{num_connections} connected\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t",
        "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_battery_percentage}%"
    },
    "network": {
        "interface": "wlan0",
        "format": "{ifname}",
        "format-wifi": "",
        "format-ethernet": "{ifname} ",
        "format-disconnected": "",
        "tooltip-format": "{ifname}",
        "tooltip-format-wifi": "{essid} ({signalStrength}%) ",
        "tooltip-format-ethernet": "{ifname} ",
        "tooltip-format-disconnected": "Disconnected",
        "max-length": 50,
        "on-click": "networkmanager_dmenu"
    },
    "group/volume": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 300,
            "transition-left-to-right": false,
            "click-to-reveal": false
        },
        "modules": ["pulseaudio", "pulseaudio/slider"]
    },

    "pulseaudio/slider": {
        "min": 0,
        "max": 100,
        "orientation": "horizontal"
    },
    "pulseaudio": {
        "format": "<span size='large'>{icon}</span>",
        "format-muted": "",
        "format-icons": {
            "headphone": "",
            "headset": "󰋎",
            "default": ["", "", "", ""]
        },
        "scroll-step": 1,
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "pavucontrol"
    },
    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 20,
        "tooltip-format": "{title}",
        "on-click": "activate"
    },
    "custom/cava": {
        "exec": "~/.config/waybar/scripts/cava.sh",
        "restart-interval": 2,
        "format": "{}",
        "tooltip": false,
        "hide-empty-text": true
    },
    "mpris": {
        "format": "{player_icon} {dynamic}",
        "format-paused": "{status_icon} {dynamic}",
        "player-icons": {
            "default": "▶",
            "spotify": "🎵"
        },
        "status-icons": {
            "paused": "⏸"
        },
        "dynamic-order": ["title", "artist"],
        "max-length": 40
    },
    "battery": {
        "format": "{icon}",
        "format-charging": "{icon}",
        "tooltip-format": "{capacity}% - {timeTo}",
        "format-icons": {
            "default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
            "charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
            "full": "󱈏"
        },
        "states": {
            "warning": 30,
            "critical": 15
        },
        "interval": 30
    }
}