configuration {
    modi: "drun,ssh,recursivebrowser";
    show-icons: true;
    drun-display-format: "{name}";
    drun-show-actions: false;
    display-drun: "󰀻";
    display-ssh: "";
    display-recursivebrowser: "";
    parse-known-hosts: false;
}

* {
    font: "EnvyCodeR Nerd Font Propo 13";
    sel-bg: #ffffff26;
    fg-dim: #ffffffb3;
    fg: #ffffff;
    border-col: rgba(255, 255, 255, 0.2);
}

window {
    location: center;
    width: 50%;
    background-color: rgba(12, 12, 12, 0.4);
    border: 0px;
    border-radius: 15px;
}

mainbox {
    orientation: horizontal;
    children: [ tabcolumn, imagebox, listbox ];
    spacing: 0;
    padding: 0;
    background-color: transparent;
}

/* far-left tabs */
tabcolumn {
    orientation: vertical;
    expand: false;
    padding: 0 10px;
    width: 3%;
    background-color: transparent;
    children: [ spacer-top, mode-switcher, spacer-bottom];
}

spacer-top, spacer-bottom {
    expand: true;
    background-color: transparent;
}

mode-switcher {
    orientation: vertical;
    expand: true;
    background-color: transparent;
}

button {
    expand: true;
    font: "EnvyCodeR Nerd Font Propo 22";
    border-radius: 100%;
    background-color: transparent;
    text-color: @fg-dim;
}

button normal {
    background-color: transparent;
    text-color: @fg-dim;
}

button selected {
    background-color: @sel-bg;
    text-color: @fg;
}

/* image column */
imagebox {
    expand: false;
    width: 25%;
    border-radius: 10px;
    background-color: transparent;
    background-image: url("~/.config/rofi/images/frieren.jpg", height);
}

/* search + list column */
listbox {
    orientation: vertical;
    padding: 10px;
    spacing: 10px;
    background-color: transparent;
    children: [ inputbar, listview ];
}

inputbar {
    children: [ prompt, entry ];
    padding: 10px 14px;
    spacing: 10px;
    border: 2px;
    border-color: @border-col;
    border-radius: 0 10px 0 10px;
    background-color: transparent;
}

prompt {
    enabled: true;
    background-color: transparent;
    text-color: @fg;
}

entry {
    background-color: transparent;
    text-color: @fg;
    cursor-width: 2px;
    placeholder: "Search...";
    placeholder-color: @fg-dim;
}

listview {
    columns: 1;
    lines: 8;
    fixed-height: true;
    scrollbar: false;
    spacing: 2px;
    background-color: transparent;
}

element {
    padding: 20px 10px;
    border-radius: 5px;
    background-color: transparent;
    text-color: @fg-dim;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color: @fg-dim;
}

element selected.normal {
    background-color: @sel-bg;
    text-color: @fg;
}

element-icon {
    size: 50px;
    background-color: transparent;
}

element-text {
    vertical-align: 0.5;
    background-color: transparent;
    text-color: inherit;
}